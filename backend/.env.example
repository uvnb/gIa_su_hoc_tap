# ==================================================================================
#  Cú Brain – cấu hình. Sao chép thành .env rồi điền khóa API. KHÔNG commit file .env
# ==================================================================================

# ===== Nhà cung cấp mặc định: anthropic | openai | mock =====
# mock = giả lập, không cần khóa API (để thử app Flutter miễn phí)
DEFAULT_PROVIDER=anthropic

# ===== Chọn nhà cung cấp + model cho từng vai trò (để trống = theo DEFAULT_PROVIDER) =====
SOLVER_PROVIDER=anthropic
SOLVER_MODEL=claude-sonnet-5-5
TUTOR_PROVIDER=anthropic
TUTOR_MODEL=claude-haiku-5-5
CHECKER_PROVIDER=anthropic
CHECKER_MODEL=claude-haiku-5-5
GUARD_PROVIDER=anthropic
GUARD_MODEL=claude-haiku-5-5

# Mức suy nghĩ của Claude (low | medium | high). Solver cần chính xác, các vai trò khác cần nhanh.
SOLVER_EFFORT=medium
TUTOR_EFFORT=low
CHECKER_EFFORT=low
GUARD_EFFORT=low

# Mức mặc định khi phụ huynh chưa chọn (FR-62): tiet_kiem | can_bang | thong_minh
DEFAULT_TIER=can_bang

# Server-side fallback của Claude khi model từ chối (chỉ áp dụng Sonnet 5.5 / Opus 5.5). 1 = bật
ANTHROPIC_SERVER_FALLBACK=1

# ===== Khóa API (CHỈ nằm trên server) =====
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=
# Điền tên model OpenAI nếu dùng ChatGPT (⚠️ VERIFY danh sách model hiện hành trên trang OpenAI)
OPENAI_VISION_MODEL=
OPENAI_CHAT_MODEL=
OPENAI_SMART_VISION_MODEL=
OPENAI_SMART_CHAT_MODEL=
# Để trống = không gửi temperature (một số model mới không nhận)
OPENAI_TEMPERATURE=

# ===== Ứng dụng =====
APP_SHARED_SECRET=change-me
IMAGE_RETENTION_HOURS=24
SESSION_RETENTION_DAYS=30
MAX_TURNS_PER_PROBLEM=12
MAX_SESSIONS_PER_DEVICE_PER_DAY=80
# smart = chỉ gọi AI giám khảo khi câu có số/từ khóa nguy hiểm (tiết kiệm); always = luôn gọi
GUARD_MODE=smart
# DB_PATH=./data/cutomo.sqlite3
